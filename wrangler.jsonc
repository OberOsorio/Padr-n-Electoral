{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "padron-electoral",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "vars": {
    "COLOMBIA_GATEWAY_URL": "https://cut-tracked-thereafter-fundamentals.trycloudflare.com"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
